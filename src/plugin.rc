#include <windows.h>
#include <winres.h>
#include "resource.h"

#pragma code_page(65001)

IDD_COLUMN_REPLACE DIALOGEX 0, 0, 400, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Column Replace"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Filter", IDC_GROUP_FILTER, 7, 7, 386, 88
    LTEXT           "Line prefix:", IDC_LABEL_PREFIX, 15, 21, 90, 10
    EDITTEXT        IDC_PREFIX, 108, 19, 120, 14, ES_AUTOHSCROLL
    CONTROL         "Match case", IDC_CASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 236, 20, 150, 12
    CONTROL         "Only lines in selection", IDC_ONLYSEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 108, 37, 120, 12
    CONTROL         "Line range", IDC_USERANGE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 54, 90, 10
    LTEXT           "from:", IDC_LABEL_LINEFROM, 112, 55, 22, 10
    EDITTEXT        IDC_FIRSTLINE, 136, 52, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "to:", IDC_LABEL_LINETO, 182, 55, 20, 10
    EDITTEXT        IDC_LASTLINE, 204, 52, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(empty = unlimited)", IDC_HINT_ALLLINES, 250, 55, 130, 10
    LTEXT           "Hint: prefix e.g. ""ABC"" = first 3 characters of a line.", IDC_HINT_PREFIX, 15, 73, 370, 10

    GROUPBOX        "Columns / fields (1-based, inclusive)", IDC_GROUP_COLUMNS, 7, 99, 386, 78
    CONTROL         "Fixed character positions", IDC_MODE_FIXED, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 15, 114, 140, 12
    CONTROL         "Delimiter-separated fields", IDC_MODE_DELIMITED, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 165, 114, 180, 12
    LTEXT           "From column:", IDC_LABEL_STARTCOL, 15, 134, 58, 10
    EDITTEXT        IDC_STARTCOL, 78, 132, 45, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "To column:", IDC_LABEL_ENDCOL, 135, 134, 55, 10
    EDITTEXT        IDC_ENDCOL, 198, 132, 45, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(empty = to end of line)", IDC_COLUMNHINT, 250, 134, 130, 10
    LTEXT           "Delimiter:", IDC_LABEL_DELIMITER, 15, 154, 60, 10
    EDITTEXT        IDC_DELIMITER, 80, 152, 30, 14, ES_AUTOHSCROLL | ES_CENTER
    LTEXT           "e.g. ; or \\t (tab)", IDC_HINT_DELIMITER, 118, 154, 200, 10

    LTEXT           "Replace with:", IDC_LABEL_REPLACEMENT, 15, 183, 80, 10
    EDITTEXT        IDC_REPLACEMENT, 100, 181, 293, 14, ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Preview", IDC_PREVIEW, 7, 203, 80, 18
    PUSHBUTTON      "Replace", IDC_REPLACE, 92, 203, 80, 18
    PUSHBUTTON      "Close", IDCANCEL, 177, 203, 80, 18

    LTEXT           "Preview (max. 20 changes):", IDC_LABEL_PREVIEW, 7, 229, 250, 10
    LTEXT           "Language:", IDC_LABEL_LANGUAGE, 266, 229, 48, 10
    COMBOBOX        IDC_LANGUAGE, 318, 227, 75, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LISTBOX         IDC_PREVIEWLIST, 7, 241, 386, 62, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | LBS_DISABLENOSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STATUS, 7, 309, 386, 10
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,1,0
PRODUCTVERSION  1,3,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName", "AncientTree / Community"
            VALUE "FileDescription", "Spalten-Ersetzen für Notepad++"
            VALUE "FileVersion", "1.3.1.0"
            VALUE "InternalName", "ColumnReplace"
            VALUE "OriginalFilename", "ColumnReplace.dll"
            VALUE "ProductName", "Spalten-Ersetzen"
            VALUE "ProductVersion", "1.3.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
